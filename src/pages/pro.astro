---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/url';
---

<Layout title="Polis Pro — Deliberation infrastructure" description="Advanced analytics, compliance tools, and dedicated support for governments and enterprises.">

<main>

<!-- Hero -->
<section class="relative overflow-hidden bg-white px-6 pb-20 pt-24 md:pb-28 md:pt-32">
	<div class="hero-grid pointer-events-none absolute inset-0 opacity-[0.03]"></div>
	<div class="relative mx-auto max-w-4xl text-center">
		<p class="mb-5 inline-flex items-center gap-2 rounded-full border border-polis-200 bg-polis-50 px-4 py-1.5 font-mono text-xs font-medium tracking-wide text-polis-700">
			POLIS PRO
		</p>
		<h1 class="mb-6 text-4xl font-bold leading-[1.1] tracking-[-0.02em] text-slate-900 md:text-6xl">
			Deliberation infrastructure for governments and institutions
		</h1>
		<p class="mx-auto mb-10 max-w-2xl text-lg leading-relaxed text-slate-600 md:text-xl">
			Everything in Polis, plus advanced analytics, compliance tools, embedded conversations, and dedicated support — built for the scale and rigor that institutions demand.
		</p>
		<div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
			<a href={withBase('/contact')} class="rounded-md bg-polis-700 px-6 py-3 text-sm font-semibold text-white no-underline shadow-sm transition-colors hover:bg-polis-800">Request a demo</a>
			<a href={withBase('/pricing')} class="rounded-md border border-slate-300 px-6 py-3 text-sm font-medium text-slate-700 no-underline transition-colors hover:bg-slate-50">View pricing</a>
		</div>
	</div>
</section>


<!-- Feature Grid -->
<section class="border-t border-slate-200 bg-slate-50 px-6 py-20">
	<div class="mx-auto max-w-6xl">
		<div class="mb-16 text-center">
			<p class="mb-2 font-mono text-xs font-medium uppercase tracking-widest text-polis-500">What you get</p>
			<h2 class="text-3xl font-bold text-slate-900">Everything you need, nothing you don't</h2>
		</div>

		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{[
				{ title: "Advanced analytics", desc: "Deep-dive into opinion group composition, consensus trends, and participation metrics. Export everything.", icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" },
				{ title: "Data export & API", desc: "Full data export in CSV and JSON. REST API access for integration with your existing reporting and analysis tools.", icon: "M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" },
				{ title: "Embedded conversations", desc: "Embed a Polis conversation directly in your organization's site, with your own branding and authentication.", icon: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" },
				{ title: "Flexible authentication", desc: "Bring your own participant identity by passing in external identifiers, and control who can take part with allow and block lists.", icon: "M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" },
				{ title: "GDPR & compliance", desc: "Data residency options, consent management, right-to-deletion support, and audit logs. Built for privacy regulations.", icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" },
				{ title: "Moderation dashboard", desc: "Review and manage participant submissions with a purpose-built moderation interface. Flag, approve, or remove statements.", icon: "M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" },
				{ title: "Priority support & SLA", desc: "Dedicated account manager, guaranteed response times, and a service-level agreement you can take to procurement.", icon: "M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" },
				{ title: "Multi-language support", desc: "Run conversations in any language. Polis Pro supports right-to-left scripts and Unicode throughout.", icon: "M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" },
			].map(({ title, desc, icon }) => (
				<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
					<div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-polis-50 text-polis-500">
						<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={icon}/></svg>
					</div>
					<h4 class="mb-2 text-base font-semibold text-slate-900">{title}</h4>
					<p class="text-sm leading-relaxed text-slate-600">{desc}</p>
				</div>
			))}
		</div>
	</div>
</section>


<!-- Compliance & Trust -->
<section class="border-t border-slate-200 bg-white px-6 py-20">
	<div class="mx-auto max-w-4xl text-center">
		<p class="mb-2 font-mono text-xs font-medium uppercase tracking-widest text-polis-500">Trust & compliance</p>
		<h2 class="mb-4 text-3xl font-bold text-slate-900">Built for institutional trust</h2>
		<p class="mx-auto mb-12 max-w-2xl text-slate-600">
			Polis is open source — every line of code is publicly auditable. Combined with our compliance tools, this gives institutions a level of transparency that proprietary platforms can't match.
		</p>
		<div class="mx-auto grid max-w-3xl gap-6 sm:grid-cols-3">
			<div class="rounded-xl border border-slate-200 p-5">
				<p class="mb-1 font-display text-lg font-bold text-polis-500">GDPR</p>
				<p class="text-xs text-slate-500">Full compliance with EU data protection regulations</p>
			</div>
			<div class="rounded-xl border border-slate-200 p-5">
				<p class="mb-1 font-display text-lg font-bold text-polis-500">AGPL-3.0</p>
				<p class="text-xs text-slate-500">Fully open source and auditable</p>
			</div>
		</div>
	</div>
</section>


<!-- Case Study Excerpts -->
<section class="border-t border-slate-200 bg-slate-50 px-6 py-20">
	<div class="mx-auto max-w-6xl">
		<div class="mb-12 text-center">
			<p class="mb-2 font-mono text-xs font-medium uppercase tracking-widest text-polis-500">In the field</p>
			<h2 class="text-3xl font-bold text-slate-900">Deployed by governments worldwide</h2>
		</div>
		<div class="grid gap-6 md:grid-cols-3">
			<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
				<p class="mb-3 text-xs font-medium uppercase tracking-wider text-polis-500">Taiwan</p>
				<h4 class="mb-2 text-lg font-semibold text-slate-900">vTaiwan</h4>
				<p class="mb-4 text-sm leading-relaxed text-slate-600">200,000+ participants shaped national legislation on ride-sharing, telemedicine, and online alcohol sales.</p>
				<a href={withBase('/case-studies')} class="text-sm font-medium text-polis-600 no-underline hover:text-polis-700">Read case study &rarr;</a>
			</div>
			<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
				<p class="mb-3 text-xs font-medium uppercase tracking-wider text-polis-500">United Kingdom</p>
				<h4 class="mb-2 text-lg font-semibold text-slate-900">Demos UK</h4>
				<p class="mb-4 text-sm leading-relaxed text-slate-600">First nationally representative Polis sample, exploring attitudes toward data-driven political campaigning.</p>
				<a href={withBase('/case-studies')} class="text-sm font-medium text-polis-600 no-underline hover:text-polis-700">Read case study &rarr;</a>
			</div>
			<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
				<p class="mb-3 text-xs font-medium uppercase tracking-wider text-polis-500">USA</p>
				<h4 class="mb-2 text-lg font-semibold text-slate-900">Bowling Green, KY</h4>
				<p class="mb-4 text-sm leading-relaxed text-slate-600">~2,000 of 65,000 residents participated in local consensus-building — a 3% participation rate.</p>
				<a href={withBase('/case-studies')} class="text-sm font-medium text-polis-600 no-underline hover:text-polis-700">Read case study &rarr;</a>
			</div>
		</div>
	</div>
</section>


<!-- Pricing Teaser -->
<section class="border-t border-slate-200 bg-polis-500 px-6 py-16 text-center">
	<div class="mx-auto max-w-3xl">
		<h2 class="mb-4 font-display text-3xl font-bold text-white">Custom pricing based on your needs</h2>
		<p class="mb-8 text-lg text-polis-100">Whether you're running a single consultation or a nationwide program, we'll build a plan that fits.</p>
		<div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
			<a href={withBase('/contact')} class="rounded-md bg-white px-6 py-3 text-sm font-semibold text-polis-600 no-underline shadow-sm transition-colors hover:bg-polis-50">Request a quote</a>
			<a href={withBase('/pricing')} class="rounded-md border border-polis-300 px-6 py-3 text-sm font-medium text-white no-underline transition-colors hover:bg-polis-600">Compare all tiers &rarr;</a>
		</div>
	</div>
</section>

</main>

</Layout>

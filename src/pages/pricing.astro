---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/url';
---

<Layout title="Pricing — Polis Pro" description="Power tools for pol.is conversations. Plans for individuals, nonprofits, and organizations.">

<main>

<!-- Hero -->
<section class="bg-white px-6 pb-16 pt-24 md:pt-32">
	<div class="mx-auto max-w-3xl text-center">
		<p class="mb-4 font-mono text-xs font-medium uppercase tracking-widest text-polis-500">Pricing</p>
		<h1 class="mb-6 text-4xl font-bold leading-[1.15] tracking-[-0.02em] text-slate-900 md:text-5xl">
			Power tools for<br />pol.is conversations
		</h1>
		<p class="mx-auto max-w-2xl text-lg leading-relaxed text-slate-600">
			Polis is used by governments, universities, nonprofits, media organizations, pro-democracy movements, and policy groups to strengthen democratic processes and expand civic participation worldwide.
		</p>
	</div>
</section>


<!-- ============================================================
     BASIC (FREE) + POLIS PRO TIERS
     ============================================================ -->
<section class="border-t border-slate-200 bg-slate-50 px-6 py-20">
	<div class="mx-auto max-w-6xl">

		<!-- Basic + Pro side by side -->
		<div class="grid gap-8 lg:grid-cols-2">

			<!-- ---- BASIC (Free) ---- -->
			<div class="rounded-xl border border-slate-200 bg-white p-8">
				<p class="mb-1 font-mono text-xs font-medium uppercase tracking-wider text-slate-400">Free forever</p>
				<h3 class="mb-1 text-2xl font-bold text-slate-900">Basic</h3>
				<p class="mb-6 text-sm text-slate-500">Everything you need to run a Polis conversation.</p>
				<p class="mb-8 text-4xl font-bold text-slate-900">$0</p>
				<a href="https://pol.is" class="mb-8 block rounded-md bg-polis-700 py-3 text-center text-sm font-medium text-white no-underline transition-colors hover:bg-polis-800">Sign up for a free account</a>
				<ul class="space-y-3 text-sm text-slate-600">
					<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> Basic reporting</li>
					<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> Automatic report generation when conversation reaches threshold</li>
					<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> Basic moderation features</li>
					<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> Manual seed statements</li>
					<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> Automatic translation for multilingual conversations</li>
				</ul>
			</div>

			<!-- ---- POLIS PRO (feature overview) ---- -->
			<div class="rounded-xl border-2 border-polis-500 bg-white p-8 shadow-md">
				<p class="mb-1 font-mono text-xs font-medium uppercase tracking-wider text-polis-500">Polis Pro</p>
				<h3 class="mb-1 text-2xl font-bold text-slate-900">Professional features</h3>
				<p class="mb-8 text-sm text-slate-500">Everything in Basic, plus advanced tools for serious deliberation.</p>

				<!-- Analysis & Reporting -->
				<h4 class="mb-3 text-sm font-semibold text-polis-600">Analysis & Reporting</h4>
				<ul class="mb-6 space-y-2.5 text-sm text-slate-600">
					<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> Real-time advanced report generation</li>
					<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> Enhanced LLM reports with multiple model choices</li>
					<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> Custom model-per-section and advanced topic analysis</li>
					<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> Auto-checker runs with every report refresh</li>
				</ul>

				<!-- Data & Language -->
				<h4 class="mb-3 text-sm font-semibold text-polis-600">Data & Language</h4>
				<ul class="mb-6 space-y-2.5 text-sm text-slate-600">
					<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> Automatic conversation translation</li>
					<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> Bulk upload seed statements (CSV/API)</li>
					<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> Raw data export via API (15-minute intervals)</li>
					<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> EU data sovereignty option</li>
				</ul>

				<!-- Security & Identity -->
				<h4 class="mb-3 text-sm font-semibold text-polis-600">Security & Identity</h4>
				<ul class="mb-6 space-y-2.5 text-sm text-slate-600">
					<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> Moderation assistance with auto abuse prevention</li>
					<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> XID (participant identity) export & whitelist management</li>
					<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> IP geo-fencing</li>
					<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> Custom auth providers (like GitHub)</li>
				</ul>

				<!-- Customization & Deployment -->
				<h4 class="mb-3 text-sm font-semibold text-polis-600">Customization & Deployment</h4>
				<ul class="space-y-2.5 text-sm text-slate-600">
					<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> UI theme customization</li>
					<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> On-prem option available for large deployments</li>
				</ul>
			</div>
		</div>
	</div>
</section>


<!-- ============================================================
     POLIS PRO TIERS (audience-based)
     ============================================================ -->
<section class="border-t border-slate-200 bg-white px-6 py-20">
	<div class="mx-auto max-w-6xl">
		<div class="mb-12 text-center">
			<p class="mb-2 font-mono text-xs font-medium uppercase tracking-widest text-polis-500">Choose your plan</p>
			<h2 class="mb-4 text-3xl font-bold text-slate-900">Polis Pro plans</h2>
			<p class="mx-auto max-w-2xl text-slate-600">Same powerful features, priced for your context. Every Pro plan includes the full feature set above.</p>
		</div>

		<div class="grid gap-6 md:grid-cols-3">
			<!-- Individual -->
			<div class="rounded-xl border border-slate-200 bg-white p-8 transition-shadow hover:shadow-md">
				<div class="mb-5 flex h-10 w-10 items-center justify-center rounded-lg bg-slate-100">
					<svg class="h-5 w-5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
				</div>
				<h3 class="mb-1 text-xl font-bold text-slate-900">Individual</h3>
				<p class="mb-4 text-sm font-medium text-slate-500">For personal, independent use</p>
				<p class="mb-6 text-sm leading-relaxed text-slate-600">
					For individuals exploring Polis for personal projects, independent research, learning, or experimentation.
				</p>
				<ul class="mb-8 space-y-2 text-xs text-slate-500">
					<li class="flex items-start gap-2"><span class="text-slate-300">&bull;</span> Non-commercial use only</li>
					<li class="flex items-start gap-2"><span class="text-slate-300">&bull;</span> Not affiliated with an organization, campaign, or employer</li>
					<li class="flex items-start gap-2"><span class="text-slate-300">&bull;</span> No client work or organizational deployment</li>
				</ul>
				<a href={withBase('/contact')} class="block rounded-md border border-slate-300 bg-white py-3 text-center text-sm font-medium text-slate-700 no-underline transition-colors hover:bg-slate-50">Request access</a>
				<p class="mt-3 text-center text-xs text-slate-400">Upgrade to any plan at any time.</p>
			</div>

			<!-- Nonprofit / Public-interest -->
			<div class="rounded-xl border-2 border-polis-500 bg-white p-8 shadow-md transition-shadow hover:shadow-lg">
				<div class="mb-5 flex h-10 w-10 items-center justify-center rounded-lg bg-polis-50">
					<svg class="h-5 w-5 text-polis-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
				</div>
				<h3 class="mb-1 text-xl font-bold text-slate-900">Nonprofit / Public-interest</h3>
				<p class="mb-4 text-sm font-medium text-polis-600">For mission-driven organizations</p>
				<p class="mb-6 text-sm leading-relaxed text-slate-600">
					For registered nonprofits, academic researchers, and public-interest projects using Polis to support civic participation, research, or community dialogue.
				</p>
				<ul class="mb-6 space-y-2 text-xs text-slate-500">
					<li class="flex items-start gap-2"><span class="text-slate-300">&bull;</span> Non-commercial, mission-aligned use</li>
					<li class="flex items-start gap-2"><span class="text-slate-300">&bull;</span> For organizations operating in the public interest</li>
					<li class="flex items-start gap-2"><span class="text-slate-300">&bull;</span> Not for political campaigns or candidates</li>
				</ul>
				<p class="mb-8 text-xs leading-relaxed text-slate-400">This tier is offered at a reduced rate to support democratic and civic work.</p>
				<a href={withBase('/contact')} class="block rounded-md bg-polis-700 py-3 text-center text-sm font-medium text-white no-underline transition-colors hover:bg-polis-800">Request access</a>
			</div>

			<!-- Commercial -->
			<div class="rounded-xl border border-slate-200 bg-white p-8 transition-shadow hover:shadow-md">
				<div class="mb-5 flex h-10 w-10 items-center justify-center rounded-lg bg-slate-100">
					<svg class="h-5 w-5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
				</div>
				<h3 class="mb-1 text-xl font-bold text-slate-900">Commercial</h3>
				<p class="mb-4 text-sm font-medium text-slate-500">For organizations & professional use</p>
				<p class="mb-6 text-sm leading-relaxed text-slate-600">
					For companies, consultants, and political campaigns using Polis in professional, organizational, or revenue-generating contexts.
				</p>
				<ul class="mb-6 space-y-2 text-xs text-slate-500">
					<li class="flex items-start gap-2"><span class="text-slate-300">&bull;</span> For-profit organizations and political campaigns</li>
					<li class="flex items-start gap-2"><span class="text-slate-300">&bull;</span> Same features as all other Pro tiers</li>
					<li class="flex items-start gap-2"><span class="text-slate-300">&bull;</span> Full operational cost pricing</li>
				</ul>
				<p class="mb-8 text-xs leading-relaxed text-slate-400">This tier reflects the full operational cost of running Polis Pro.</p>
				<a href={withBase('/contact')} class="block rounded-md border border-slate-300 bg-white py-3 text-center text-sm font-medium text-slate-700 no-underline transition-colors hover:bg-slate-50">Request access</a>
			</div>
		</div>

		<!-- Plan selection footer -->
		<p class="mt-8 text-center text-sm text-slate-400">Not sure which plan applies? Choose your best fit — we'll reach out if clarification is needed.</p>
	</div>
</section>


<!-- ============================================================
     OPEN DATA INITIATIVE
     ============================================================ -->
<section class="border-t border-slate-200 bg-slate-50 px-6 py-16">
	<div class="mx-auto max-w-3xl">
		<div class="rounded-xl border border-slate-200 bg-white p-8 md:p-10">
			<h3 class="mb-4 text-xl font-bold text-slate-900">Our Open Data Initiative</h3>
			<p class="mb-4 text-sm leading-relaxed text-slate-600">
				As part of our nonprofit mission, pol.is maintains an open data portal where public-interest conversations can be shared for research and public benefit. Organizations that commit to contributing data to this portal may qualify for reduced pricing.
			</p>
			<p class="mb-4 text-sm font-medium text-slate-700">When you make your pol.is conversation data open:</p>
			<ul class="mb-6 space-y-2 text-sm text-slate-600">
				<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&bull;</span> You help build a public resource of deliberative data</li>
				<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&bull;</span> You contribute to research on democratic processes</li>
				<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&bull;</span> You demonstrate transparency in your community engagement</li>
			</ul>
			<p class="text-sm italic text-slate-500">
				Contact us to learn more about how the open data initiative aligns with our 501(c)(3) nonprofit mission and how your organization can participate.
			</p>
		</div>
	</div>
</section>


<!-- ============================================================
     SELF-HOSTED
     ============================================================ -->
<section class="border-t border-slate-200 bg-white px-6 py-20">
	<div class="mx-auto max-w-3xl text-center">
		<p class="mb-2 font-mono text-xs font-medium uppercase tracking-widest text-polis-500">Open source</p>
		<h2 class="mb-4 text-3xl font-bold text-slate-900">Self-hosted</h2>
		<p class="mx-auto mb-8 max-w-xl text-slate-600">
			Run Polis on your own infrastructure. Full source code, Docker deployment, community documentation. Free under AGPL-3.0.
		</p>
		<div class="mx-auto max-w-sm rounded-xl border border-slate-200 bg-white p-8">
			<p class="mb-6 text-4xl font-bold text-slate-900">Free<span class="ml-1 text-base font-normal text-slate-400">/ AGPL</span></p>
			<ul class="mb-8 space-y-3 text-left text-sm text-slate-600">
				<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> Full source code</li>
				<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> Docker deployment</li>
				<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> Community wiki & docs</li>
				<li class="flex items-start gap-2.5"><span class="mt-0.5 text-polis-500">&#10003;</span> GitHub issues support</li>
				<li class="flex items-start gap-2.5"><span class="mt-0.5 text-slate-300">&#10007;</span> <span class="text-slate-400">No managed hosting</span></li>
				<li class="flex items-start gap-2.5"><span class="mt-0.5 text-slate-300">&#10007;</span> <span class="text-slate-400">No formal SLA</span></li>
			</ul>
			<a href="https://github.com/compdemocracy/polis" class="block rounded-md border border-slate-300 bg-white py-3 text-center text-sm font-medium text-slate-700 no-underline transition-colors hover:bg-slate-50">View on GitHub</a>
		</div>
	</div>
</section>


<!-- FAQ -->
<section class="border-t border-slate-200 bg-slate-50 px-6 py-20">
	<div class="mx-auto max-w-3xl">
		<div class="mb-12 text-center">
			<p class="mb-2 font-mono text-xs font-medium uppercase tracking-widest text-polis-500">FAQ</p>
			<h2 class="text-3xl font-bold text-slate-900">Frequently asked questions</h2>
		</div>

		<div class="space-y-6">
			{[
				{ q: "What's the difference between Basic and Polis Pro?", a: "Basic gives you everything you need to run a Polis conversation — reporting, moderation, seed statements, and multilingual support. Polis Pro adds advanced analytics with LLM-powered reports, raw data export via API, enhanced moderation with abuse prevention, identity management, geo-fencing, and more." },
				{ q: "Do all Pro plans include the same features?", a: "Yes. Individual, Nonprofit, and Commercial plans all include the full Polis Pro feature set. The tiers differ only in pricing and eligibility — not in capabilities." },
				{ q: "Who owns the data from my Polis conversations?", a: "You do. On our hosted platform, you can export all conversation data at any time. With the self-hosted version, your data never touches our servers." },
				{ q: "How does the Open Data Initiative affect pricing?", a: "Organizations that contribute their public-interest conversation data to our open data portal may qualify for reduced pricing. Contact us to learn more." },
				{ q: "Which plan should I choose?", a: "Individual is for personal, non-commercial use with no organizational affiliation. Nonprofit is for registered nonprofits, academics, and public-interest projects. Commercial is for companies, consultants, and campaigns. Choose your best fit — we'll reach out if clarification is needed." },
				{ q: "Is Polis Pro GDPR compliant?", a: "Yes. Polis Pro includes EU data sovereignty options, consent management, and audit-ready infrastructure. We can provide a Data Processing Agreement (DPA)." },
				{ q: "What does open source mean for my deployment?", a: "Polis is licensed under AGPL-3.0. You can audit every line of code, contribute improvements, and self-host without any licensing fees." },
				{ q: "Can I upgrade or switch plans later?", a: "Yes. You can move from Basic to any Pro plan, or between Pro tiers, at any time. Your conversations and data carry over." },
			].map(({ q, a }) => (
				<div class="rounded-xl border border-slate-200 bg-white p-6">
					<h4 class="mb-2 text-base font-semibold text-slate-900">{q}</h4>
					<p class="text-sm leading-relaxed text-slate-600">{a}</p>
				</div>
			))}
		</div>
	</div>
</section>


<!-- CTA -->
<section class="border-t border-slate-200 bg-polis-500 px-6 py-16 text-center">
	<div class="mx-auto max-w-3xl">
		<h2 class="mb-4 font-display text-3xl font-bold text-white">Ready to hear what people really think?</h2>
		<p class="mb-8 text-lg text-polis-100">Start a Polis conversation in minutes. Free, open source, no account required.</p>
		<div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
			<a href="https://pol.is" class="rounded-md bg-white px-6 py-3 text-sm font-semibold text-polis-600 no-underline shadow-sm transition-colors hover:bg-polis-50">Start a conversation</a>
			<a href={withBase('/contact')} class="rounded-md border border-polis-300 px-6 py-3 text-sm font-medium text-white no-underline transition-colors hover:bg-polis-600">Talk to us &rarr;</a>
		</div>
	</div>
</section>

</main>

</Layout>

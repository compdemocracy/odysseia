---
import Layout from '../../layouts/Layout.astro';
import { caseStudies, getRelatedCaseStudies } from '../../data/caseStudies';

export function getStaticPaths() {
	return caseStudies.map((study) => ({
		params: { slug: study.slug },
		props: { study },
	}));
}

const { study } = Astro.props;
const related = getRelatedCaseStudies(study.slug);
---

<Layout title={`${study.title} — Polis Case Study`} description={study.summary}>

<main>

<!-- Header -->
<section class="bg-white px-6 pb-12 pt-24 md:pt-32">
	<div class="mx-auto max-w-3xl">
		<a href="/case-studies" class="mb-6 inline-flex items-center text-sm font-medium text-polis-600 no-underline hover:text-polis-700">&larr; All case studies</a>
		<div class="mb-5 flex flex-wrap items-center gap-2">
			<span class="inline-flex items-center rounded-full bg-polis-50 px-3 py-1 font-mono text-xs font-medium text-polis-600">{study.country}</span>
			<span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 font-mono text-xs font-medium text-slate-500">{study.sector}</span>
			<span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 font-mono text-xs font-medium text-slate-500">{study.year}</span>
		</div>
		<h1 class="mb-5 text-4xl font-bold leading-[1.15] tracking-[-0.02em] text-slate-900 md:text-5xl">{study.title}</h1>
		<p class="text-lg leading-relaxed text-slate-600">{study.summary}</p>
	</div>
</section>


<!-- Stats band -->
<section class="border-y border-slate-200 bg-slate-50 px-6 py-10">
	<div class="mx-auto grid max-w-3xl grid-cols-3 gap-4">
		{study.stats.map((stat) => (
			<div class="text-center">
				<p class="font-display text-3xl font-bold text-polis-500 md:text-4xl">{stat.value}</p>
				<p class="mt-1 text-sm text-slate-500">{stat.label}</p>
			</div>
		))}
	</div>
</section>


<!-- Body -->
<article class="bg-white px-6 py-16">
	<div class="mx-auto max-w-[70ch] space-y-12">
		<div>
			<h2 class="mb-3 text-2xl font-bold text-slate-900">Context</h2>
			<p class="leading-relaxed text-slate-600">{study.context}</p>
		</div>

		<div>
			<h2 class="mb-3 text-2xl font-bold text-slate-900">Process</h2>
			<p class="leading-relaxed text-slate-600">{study.process}</p>
		</div>

		<div>
			<h2 class="mb-3 text-2xl font-bold text-slate-900">Results</h2>
			<p class="leading-relaxed text-slate-600">{study.results}</p>
		</div>

		<!-- Visualization placeholder -->
		<div>
			<h2 class="mb-3 text-2xl font-bold text-slate-900">Opinion landscape</h2>
			<div class="flex items-center justify-center rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 px-8 py-16 text-center">
				<div>
					<p class="font-mono text-sm text-slate-400">[ Opinion group visualization ]</p>
					<p class="mt-2 text-xs text-slate-300">Cluster map and key statistics — to be added with sourced data</p>
				</div>
			</div>
		</div>

		<!-- Pull quote -->
		<blockquote class="border-l-2 border-polis-300 pl-6">
			<p class="text-xl font-medium italic leading-relaxed text-slate-700">"{study.quote.text}"</p>
			<footer class="mt-3 text-sm font-medium not-italic text-slate-500">— {study.quote.attribution}</footer>
		</blockquote>
	</div>
</article>


<!-- Related -->
{related.length > 0 && (
	<section class="border-t border-slate-200 bg-slate-50 px-6 py-16">
		<div class="mx-auto max-w-6xl">
			<h2 class="mb-8 text-2xl font-bold text-slate-900">More case studies</h2>
			<div class="grid gap-6 md:grid-cols-3">
				{related.map((item) => (
					<a href={`/case-studies/${item.slug}`} class="group flex flex-col rounded-xl border border-slate-200 bg-white p-6 no-underline shadow-sm transition-shadow hover:shadow-md">
						<span class="mb-3 text-xs font-medium uppercase tracking-wider text-polis-500">{item.country}</span>
						<h3 class="mb-2 text-lg font-semibold text-slate-900 group-hover:text-polis-700">{item.title}</h3>
						<p class="mb-4 flex-1 text-sm leading-relaxed text-slate-600">{item.summary}</p>
						<span class="text-sm font-medium text-polis-600 group-hover:text-polis-700">Read &rarr;</span>
					</a>
				))}
			</div>
		</div>
	</section>
)}


<!-- CTA -->
<section class="border-t border-slate-200 bg-polis-950 px-6 py-16 text-center">
	<div class="mx-auto max-w-3xl">
		<h2 class="mb-4 font-display text-3xl font-bold text-white">Could Polis work for your community?</h2>
		<p class="mb-8 text-lg text-slate-300">Start a free conversation, or talk to us about institutional deployments.</p>
		<div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
			<a href="https://pol.is" class="rounded-md bg-white px-6 py-3 text-sm font-semibold text-polis-700 no-underline shadow-sm transition-colors hover:bg-polis-50">Get started — free</a>
			<a href="/contact" class="rounded-md border border-polis-700 px-6 py-3 text-sm font-medium text-polis-200 no-underline transition-colors hover:bg-polis-900">Talk to us &rarr;</a>
		</div>
	</div>
</section>

</main>

</Layout>

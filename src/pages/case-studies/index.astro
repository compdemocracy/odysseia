---
import Layout from '../../layouts/Layout.astro';
import { caseStudies } from '../../data/caseStudies';

const featured = caseStudies.find((study) => study.featured) ?? caseStudies[0];
const rest = caseStudies.filter((study) => study.slug !== featured.slug);

const regions = Array.from(new Set(caseStudies.map((study) => study.region))).sort();
const sectors = Array.from(new Set(caseStudies.map((study) => study.sector))).sort();
---

<Layout title="Case Studies — Polis in the field" description="How governments, civil society, and communities use Polis to find common ground at scale.">

<main>

<!-- Hero -->
<section class="bg-white px-6 pb-16 pt-24 md:pt-32">
	<div class="mx-auto max-w-3xl text-center">
		<p class="mb-4 font-mono text-xs font-medium uppercase tracking-widest text-polis-500">Case studies</p>
		<h1 class="mb-6 text-4xl font-bold leading-[1.15] tracking-[-0.02em] text-slate-900 md:text-5xl">
			Collective intelligence, in the real world.
		</h1>
		<p class="mx-auto max-w-2xl text-lg leading-relaxed text-slate-600">
			From national governments to local communities, organizations use Polis to hear everyone and find the ideas that bridge divides. Here's what that looks like in practice.
		</p>
	</div>
</section>


<!-- Featured case study -->
<section class="border-t border-slate-200 bg-slate-50 px-6 py-16">
	<div class="mx-auto max-w-6xl">
		<a href={`/case-studies/${featured.slug}`} class="group block no-underline">
			<div class="grid items-center gap-10 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition-shadow hover:shadow-md md:grid-cols-2 md:p-12">
				<div>
					<div class="mb-4 flex flex-wrap items-center gap-2">
						<span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 font-mono text-xs font-medium text-amber-700">Featured</span>
						<span class="inline-flex items-center rounded-full bg-polis-50 px-3 py-1 font-mono text-xs font-medium text-polis-600">{featured.country}</span>
					</div>
					<h2 class="mb-3 text-3xl font-bold text-slate-900 group-hover:text-polis-700">{featured.title}</h2>
					<p class="mb-6 leading-relaxed text-slate-600">{featured.summary}</p>
					<span class="inline-flex items-center text-sm font-medium text-polis-600 group-hover:text-polis-700">Read the full story &rarr;</span>
				</div>
				<div class="grid grid-cols-3 gap-4">
					{featured.stats.map((stat) => (
						<div class="rounded-xl border border-slate-200 bg-slate-50 p-4 text-center">
							<p class="font-display text-2xl font-bold text-polis-500">{stat.value}</p>
							<p class="mt-1 text-xs text-slate-500">{stat.label}</p>
						</div>
					))}
				</div>
			</div>
		</a>
	</div>
</section>


<!-- Filters + grid -->
<section class="border-t border-slate-200 bg-white px-6 py-16 md:py-20">
	<div class="mx-auto max-w-6xl">
		<!-- Filter bar (visual placeholder; wiring is a later phase) -->
		<div class="mb-10 flex flex-wrap items-center gap-3">
			<span class="mr-1 text-xs font-medium uppercase tracking-wider text-slate-400">Filter</span>
			<button class="rounded-full border border-polis-300 bg-polis-50 px-4 py-1.5 text-sm font-medium text-polis-700">All</button>
			{regions.map((region) => (
				<button class="rounded-full border border-slate-200 px-4 py-1.5 text-sm font-medium text-slate-600 transition-colors hover:border-slate-300 hover:bg-slate-50">{region}</button>
			))}
			{sectors.map((sector) => (
				<button class="rounded-full border border-slate-200 px-4 py-1.5 text-sm font-medium text-slate-600 transition-colors hover:border-slate-300 hover:bg-slate-50">{sector}</button>
			))}
		</div>

		<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			{rest.map((study) => (
				<a href={`/case-studies/${study.slug}`} class="group flex flex-col rounded-xl border border-slate-200 bg-white p-6 no-underline shadow-sm transition-shadow hover:shadow-md">
					<div class="mb-3 flex items-center justify-between">
						<span class="text-xs font-medium uppercase tracking-wider text-polis-500">{study.country}</span>
						<span class="rounded-sm bg-slate-100 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wide text-slate-500">{study.sector}</span>
					</div>
					<h3 class="mb-2 text-lg font-semibold text-slate-900 group-hover:text-polis-700">{study.title}</h3>
					<p class="mb-4 flex-1 text-sm leading-relaxed text-slate-600">{study.summary}</p>
					<div class="flex items-center justify-between border-t border-slate-100 pt-4">
						<span class="font-display text-sm font-bold text-polis-500">{study.participants}<span class="ml-1 font-sans text-xs font-normal text-slate-400">participants</span></span>
						<span class="text-sm font-medium text-polis-600 group-hover:text-polis-700">Read &rarr;</span>
					</div>
				</a>
			))}
		</div>

		<p class="mt-10 text-center text-sm text-slate-400">More case studies are on the way as we source them with the CompDemocracy team.</p>
	</div>
</section>


<!-- CTA -->
<section class="border-t border-slate-200 bg-polis-950 px-6 py-16 text-center">
	<div class="mx-auto max-w-3xl">
		<h2 class="mb-4 font-display text-3xl font-bold text-white">Run your own deliberation</h2>
		<p class="mb-8 text-lg text-slate-300">Whether you're a government, a nonprofit, or a classroom, Polis scales to your conversation.</p>
		<div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
			<a href="https://pol.is" class="rounded-md bg-white px-6 py-3 text-sm font-semibold text-polis-700 no-underline shadow-sm transition-colors hover:bg-polis-50">Get started — free</a>
			<a href="/contact" class="rounded-md border border-polis-700 px-6 py-3 text-sm font-medium text-polis-200 no-underline transition-colors hover:bg-polis-900">Talk to us &rarr;</a>
		</div>
	</div>
</section>

</main>

</Layout>

---
const currentPath = Astro.url.pathname;

function isActive(path: string): boolean {
	return currentPath === path || currentPath.startsWith(path + '/');
}
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/90 backdrop-blur-sm">
	<nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
		<!-- Logo -->
		<a href="/" class="flex items-center gap-2 no-underline hover:no-underline">
			<div class="flex h-8 w-8 items-center justify-center rounded-md bg-polis-500 font-display text-sm font-bold text-white">P</div>
			<span class="font-display text-lg font-semibold text-slate-900">polis</span>
		</a>

		<!-- Desktop nav -->
		<div class="hidden items-center gap-1 text-sm font-medium text-slate-600 md:flex">
			<!-- Product dropdown -->
			<div class="group relative">
				<button class:list={[
					"flex items-center gap-1 rounded-md px-3 py-2 transition-colors hover:bg-slate-50 hover:text-slate-900",
					(isActive('/pro') || isActive('/pricing')) && "text-polis-600"
				]}>
					Product
					<svg class="h-3.5 w-3.5 opacity-50 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
					</svg>
				</button>
				<div class="invisible absolute left-0 top-full pt-1 opacity-0 transition-all group-hover:visible group-hover:opacity-100">
					<div class="w-52 rounded-lg border border-slate-200 bg-white p-2 shadow-lg">
						<a href="/pro" class="block rounded-md px-3 py-2.5 text-slate-700 no-underline hover:bg-slate-50 hover:text-slate-900">
							<div class="font-medium">Polis Pro</div>
							<div class="mt-0.5 text-xs text-slate-400">For governments & enterprises</div>
						</a>
						<a href="/pricing" class="block rounded-md px-3 py-2.5 text-slate-700 no-underline hover:bg-slate-50 hover:text-slate-900">
							<div class="font-medium">Pricing</div>
							<div class="mt-0.5 text-xs text-slate-400">Free, Pro & Self-Hosted</div>
						</a>
					</div>
				</div>
			</div>

			<a href="/case-studies" class:list={[
				"rounded-md px-3 py-2 transition-colors hover:bg-slate-50 hover:text-slate-900",
				isActive('/case-studies') && "text-polis-600"
			]}>Case Studies</a>

			<a href="/press" class:list={[
				"rounded-md px-3 py-2 transition-colors hover:bg-slate-50 hover:text-slate-900",
				isActive('/press') && "text-polis-600"
			]}>Press</a>

			<a href="/about" class:list={[
				"rounded-md px-3 py-2 transition-colors hover:bg-slate-50 hover:text-slate-900",
				isActive('/about') && "text-polis-600"
			]}>About</a>
		</div>

		<!-- CTA buttons -->
		<div class="hidden items-center gap-3 md:flex">
			<a href="/contact" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 no-underline transition-colors hover:bg-slate-50 hover:text-slate-900">Contact us</a>
			<a href="https://pol.is" class="rounded-md bg-polis-700 px-4 py-2 text-sm font-medium text-white no-underline transition-colors hover:bg-polis-800">Get started</a>
		</div>

		<!-- Mobile hamburger -->
		<button
			id="mobile-menu-btn"
			class="flex h-10 w-10 items-center justify-center rounded-md text-slate-600 hover:bg-slate-50 md:hidden"
			aria-label="Open menu"
		>
			<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
		</button>
	</nav>

	<!-- Mobile menu panel -->
	<div id="mobile-menu" class="hidden border-t border-slate-200 bg-white px-6 py-4 md:hidden">
		<div class="flex flex-col gap-1">
			<a href="https://pol.is" class="mb-2 block rounded-md bg-polis-700 px-4 py-2.5 text-center text-sm font-medium text-white no-underline transition-colors hover:bg-polis-800">Get started</a>
			<a href="/contact" class="mb-3 block rounded-md border border-slate-300 px-4 py-2.5 text-center text-sm font-medium text-slate-700 no-underline transition-colors hover:bg-slate-50">Contact us</a>
			<div class="border-t border-slate-100 pt-3"></div>
			<a href="/pro" class="rounded-md px-3 py-2.5 text-sm font-medium text-slate-700 no-underline hover:bg-slate-50">Polis Pro</a>
			<a href="/pricing" class="rounded-md px-3 py-2.5 text-sm font-medium text-slate-700 no-underline hover:bg-slate-50">Pricing</a>
			<a href="/case-studies" class="rounded-md px-3 py-2.5 text-sm font-medium text-slate-700 no-underline hover:bg-slate-50">Case Studies</a>
			<a href="/press" class="rounded-md px-3 py-2.5 text-sm font-medium text-slate-700 no-underline hover:bg-slate-50">Press</a>
			<a href="/about" class="rounded-md px-3 py-2.5 text-sm font-medium text-slate-700 no-underline hover:bg-slate-50">About</a>
		</div>
	</div>
</header>

<script>
	const btn = document.getElementById('mobile-menu-btn');
	const menu = document.getElementById('mobile-menu');
	btn?.addEventListener('click', () => {
		menu?.classList.toggle('hidden');
	});
</script>
